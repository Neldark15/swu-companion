# Copiar a services/juego/.env. Nunca usar secretos service_role.
JUEGO_HOST=127.0.0.1
JUEGO_PORT=3001
JUEGO_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
# Ruta absoluta en despliegue; montar volumen persistente. Un proceso por archivo.
JUEGO_DATOS=./.datos/salas.sqlite
# Solo local; tokens dev:alpha, dev:beta, dev:gamma. Prohibido NODE_ENV=production.
JUEGO_DEV_AUTH=0
SUPABASE_URL=
SUPABASE_ANON_KEY=
