{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/meta-ingesta",
      "schedule": "7 */6 * * *"
    },
    {
      "path": "/api/torneos-vencidos",
      "schedule": "23 11 * * *"
    }
  ],
  "functions": {
    "api/meta-ingesta.ts": {
      "maxDuration": 300
    }
  }
}
